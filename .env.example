# OpenAI (локальная разработка без AI Integration)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLED=false

# noteapp-ai-integration (production — обход региональной блокировки OpenAI)
AI_INTEGRATION_ENABLED=true
AI_INTEGRATION_BASE_URL=https://your-ai-integration-host
AI_INTEGRATION_API_KEY=aikey_...
AI_INTEGRATION_USER_EMAIL=finds@example.com
AI_INTEGRATION_USER_PASSWORD=
AI_INTEGRATION_USER_FULL_NAME=Finds
# Опционально: фиксированный userId для /api/ai/process (иначе UUID после register/login)
AI_INTEGRATION_USER_ID=
# Опционально: имя нейросети в админке AI Integration (если пусто — авто-выбор)
AI_INTEGRATION_NETWORK_NAME=

# Telegram User API (Saved Messages через session-файл Telethon)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./data/telegram.session
TELEGRAM_USER_API_ENABLED=true
PYTHON_EXECUTABLE=python
TELEGRAM_USER_SYNC_SCRIPT=scripts/sync_saved_messages.py
TELEGRAM_USER_MESSAGE_LIMIT=500
APP_PROJECT_ROOT=..

# Telegram Bot (дополнительный способ — пересылка сообщений боту)

# GitHub (опционально, для рейтинга stars)
GITHUB_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ENABLED=true

# App
SERVER_PORT=8080
DATABASE_PATH=../data/favorites.db
APP_TIMEZONE=Europe/Moscow
SYNC_CRON=0 0 8,20 * * *
# Одноразовое объединение категорий (см. docs/CATEGORY_CONSOLIDATION.md)
CATEGORY_CONSOLIDATION_ENABLED=false
CATEGORY_CONSOLIDATION_MAX_CATEGORIES=20
CATEGORY_CONSOLIDATION_BATCH_SIZE=15
# Production: https://finds.altacod.com
SITE_URL=http://localhost:8080
SITE_NAME=Finds — полезные сервисы и приложения

# Frontend (build-time, для canonical/OG в SPA)
# Production: https://finds.altacod.com
VITE_SITE_URL=http://localhost:8080
VITE_YANDEX_METRIKA_ID=109312391
